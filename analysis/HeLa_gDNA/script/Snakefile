        """


# ============================================================
# 9. MultiQC
# ============================================================
rule multiqc:
    input:
        expand(f"{config['qc_dir']}/fastqc_raw/{{sample}}_1_fastqc.zip", sample=SAMPLES),
        expand(f"{config['qc_dir']}/fastqc_raw/{{sample}}_2_fastqc.zip", sample=SAMPLES),
        expand(f"{config['trim_dir']}/{{sample}}_1_val_1_fastqc.zip", sample=SAMPLES),
        expand(f"{config['trim_dir']}/{{sample}}_2_val_2_fastqc.zip", sample=SAMPLES),
        expand(f"{config['trim_dir']}/{{sample}}_1_val_1_fastqc.html", sample=SAMPLES),
        expand(f"{config['trim_dir']}/{{sample}}_2_val_2_fastqc.html", sample=SAMPLES),
        expand(f"{config['qc_dir']}/mapping_efficiency/{{sample}}.mapping_efficiency.tsv", sample=SAMPLES),
        f"{config['qc_dir']}/mapping_efficiency/mapping_efficiency.all.tsv",
        expand(f"{config['qc_dir']}/insert_size_dedup/{{sample}}_insert_size_metrics.txt", sample=SAMPLES),
        expand(f"{config['qc_dir']}/samtools_coverage/{{sample}}.coverage.txt", sample=SAMPLES),
        expand(f"{config['qc_dir']}/gcbias_dedup/{{sample}}.gc_bias_metrics.txt", sample=SAMPLES),
        expand(f"{config['qc_dir']}/wgs_dedup/{{sample}}_collect_wgs_metrics.txt", sample=SAMPLES),
        expand(f"{config['qc_dir']}/mbias/{{sample}}.mbias.done", sample=SAMPLES)
    output:
        f"{config['qc_dir']}/multiqc/multiqc_report.html"
    params:
        outdir = f"{config['qc_dir']}/multiqc"
    shell:
        r"""
        mkdir -p {params.outdir}
        module load multiqc/1.28

        multiqc {config[qc_dir]} {config[trim_dir]} {config[dedup_dir]} {config[methyldackel_dir]} \
            -o {params.outdir} \
            -f
        """
